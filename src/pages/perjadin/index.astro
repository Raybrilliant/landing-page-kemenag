---
import DataTableFromCSV from '@/components/DataTableFromCsv';
import BaseLayout from '@/layouts/BaseLayout.astro'

const csvUrl = () => {
    return {
        url: "https://docs.google.com/spreadsheets/d/e/2PACX-1vS8NxHN7O3OCWAVj8SL3EIytT0GYlj_x7-Anj2HJgo0-m9z2Hub1Vue3td1Q6Hr-HTd2ZpfJ6tfy1Ta/pub?gid=2006508088&single=true&output=csv",
        table: true,
        filterYear: false,
        visibleCols: [1, 2, 3, 4, 5, 6],
    };
}
let lastUpdate = '';
if (csvUrl().url) {
    try {
        const res = await fetch(csvUrl().url);
        const txt = await res.text();
        const rows = txt.split('\n');
        const cols = (rows[1] ?? '').split(',');
        lastUpdate = cols[2]?.trim().replace(/^"|"$/g, '') ?? '';
    } catch {
        // silently fail
    }
}
---

<BaseLayout title={`Perjalanan Dinas`}>
    <div class="mx-20 max-sm:mx-5 mt-30 mb-15 space-y-2">
        <h1 class="text-3xl font-bold capitalize max-sm:text-2xl">
            Jadwal Perjalanan Dinas
        </h1>
        <p class="opacity-70">
            Informasi publik ini dapat diakses secara gratis. Masyarakat dapat mengetahui jadwal perjalanan dinas yang dilaksanakan oleh pegawai Kantor Kementerian Agama Kota Probolinggo.
        </p>
        {lastUpdate && (
            <p class="text-sm text-end text-gray-500 animate-pulse">
                Terakhir diperbarui: <span class="font-medium">{lastUpdate}</span>
            </p>
            <p class="text-sm text-end text-gray-500 font-medium">
                Sumber Data Kantor Kementerian Agama Kota Probolinggo
            </p>
        )}

        {
            csvUrl().table && (
                <DataTableFromCSV
                    client:load
                    csvUrl={csvUrl().url}
                    visibleCols={csvUrl().visibleCols}
                />
            )
        }
    </div>
</BaseLayout>
